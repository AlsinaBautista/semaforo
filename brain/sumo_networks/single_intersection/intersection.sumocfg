<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO Configuration for 4-way, 2-lane intersection -->
<!-- Semáforo Inteligente Project -->
<!-- Run with: sumo -c intersection.sumocfg -->
<!-- Or GUI:   sumo-gui -c intersection.sumocfg -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="intersection.net.xml"/>
        <route-files value="intersection.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <processing>
        <!-- Disable teleporting: vehicles wait indefinitely at jammed edges -->
        <time-to-teleport value="-1"/>
    </processing>

    <report>
        <!-- Suppress per-step simulation log for cleaner output -->
        <no-step-log value="true"/>
    </report>

</configuration>
